# =============================================================================
# nginx.conf.template — Repositório de Aulas (produção, Opção A)
# Renderizado pelo docker-entrypoint.sh via envsubst.
# Os server blocks ficam em conf.d/*.conf (também gerados a partir de templates).
# =============================================================================

worker_processes auto;

events {
    worker_connections 1024;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;

    sendfile on;
    tcp_nopush on;
    keepalive_timeout 65;
    server_tokens off;
    client_max_body_size 10m;

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css text/xml application/json application/javascript application/xml+rss image/svg+xml;

    map $http_upgrade $connection_upgrade {
        default upgrade;
        ''      close;
    }

    upstream bun_server {
        server bun-server:8080;
    }

    include /etc/nginx/conf.d/*.conf;
}