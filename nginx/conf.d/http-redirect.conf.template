# Server block HTTP — usado quando o certificado JÁ existe.
# Redireciona tudo para HTTPS, exceto o desafio ACME.
server {
    listen 80;
    listen [::]:80;
    server_name ${SERVER_NAME} _;

    # Desafio ACME (Let's Encrypt) — necessário na renovação
    location /.well-known/acme-challenge/ {
        root ${verificationDir};
        default_type text/plain;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}