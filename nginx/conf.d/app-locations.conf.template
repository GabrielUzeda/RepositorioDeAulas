# =============================================================================
# Locations de aplicação — comuns aos modos HTTP-only e HTTPS.
#
# IMPORTANTE (segurança): /materias, /disciplinas, /api e /cursos são SEMPRE
# proxiados para o bun-server. NUNCA sirva esses caminhos direto do disco:
# - /materias/* contém os HTMLs gerados pelo Marp, que são protegidos por
#   senha de curso (checada no Bun) e recebem CSP do Bun. Servir do mount
#   anularia a proteção.
# =============================================================================

    # ---------- API: repassa para o Bun removendo o prefixo /api ----------
    location /api/ {
        proxy_pass http://bun-server:8080/;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        $connection_upgrade;
    }

    # ---------- Conteúdo gerado (Marp) — autenticação feita no Bun ----------
    location /materias/ {
        proxy_pass http://bun-server:8080;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /disciplinas/ {
        proxy_pass http://bun-server:8080;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # ---------- Catálogo de cursos ----------
    location /cursos/ {
        proxy_pass http://bun-server:8080;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # ---------- Assets buildados (nome com hash) — cache longo ----------
    location /assets/ {
        root /usr/share/nginx/html;
        expires 1y;
        add_header Cache-Control "public, immutable";
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header X-Content-Type-Options nosniff always;
        try_files $uri =404;
    }

    # ---------- SPA: fallback para index.html (vue-router history mode) ----------
    location / {
        root /usr/share/nginx/html;
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache";
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header X-Content-Type-Options nosniff always;
    }