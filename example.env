SERVER_NAME=
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=
PROFESSOR_PASSWORD=senhasecreta

# Caminhos do deploy (docker-compose.prod.yml)
# frontDir deve apontar para o diretório com os arquivos web (conteúdo de frontend/src/)
frontDir=/var/www/html
sslDir=/var/www/ssl
verificationDir=/var/www/validation

# Backend (opcionais, usam padrões razoáveis se ausentes)
# HOST=0.0.0.0
# PORT=8080
# DATA_DIR=./backend/data
# DB_PATH=./backend/data/app.db
# FRONTEND_STATIC_DIR=./frontend/src
# TEMPLATES_DIR=./backend/src/templates
