# ==============================================================================
# ARCHITECTURE & ENVIRONMENT CONFIGURATION (example.env)
# ==============================================================================
# Renomeie ou copie este arquivo para `.env` na raiz do projeto antes de iniciar.
# Exemplo: cp example.env .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CREDENCIAIS DE SEED E AUTENTICAÇÃO
# ------------------------------------------------------------------------------
# E-mail inicial do Administrador mestre criado no seed do banco de dados SQLite.
PROFESSOR_EMAIL=admin@escola.com

# Senha inicial do Administrador mestre criada no seed do banco de dados SQLite.
# Obrigatório alterar para uma senha forte em produção.
PROFESSOR_PASSWORD=MudeEstaSenha!

# Chave secreta usada para assinatura e verificação de tokens JWT de autenticação.
# Em produção, utilize uma string longa, criptograficamente segura e aleatória.
JWT_SECRET=change-me-to-a-random-secret-key-production-2026

# Chave de criptografia simétrica AES-256-GCM para dados sensíveis em repouso (LGPD).
# Utilizada para criptografar respostas de alunos e dados protegidos no banco.
# Se não fornecida, o sistema utiliza JWT_SECRET como chave de derivação.
ENCRYPTION_KEY_256=sua-chave-secreta-de-criptografia-32-bytes-aqui

# ------------------------------------------------------------------------------
# 2. CONFIGURAÇÕES DO SERVIDOR BACKEND (HONO / BUN)
# ------------------------------------------------------------------------------
# Interface de rede / IP de escuta do servidor HTTP backend (padrão: 0.0.0.0).
# HOST=0.0.0.0

# Porta TCP onde o backend Bun/Hono escuta requisições (padrão: 8080).
# PORT=8080

# Caminho para o arquivo do banco de dados SQLite principal (o backend lê DATABASE_PATH).
# Padrão no host: ./backend/data/app.db | No container Docker: /app/data/app.db
# DATABASE_PATH=./backend/data/app.db

# Diretório base para persistência de dados.
# DATA_DIR=./backend/data

# Origens permitidas para requisições cross-origin (CORS). Lista separada por vírgula.
# Em ambiente de desenvolvimento local, o fallback padrão é http://localhost.
# Em produção, informe explicitamente a URL pública da sua aplicação.
# CORS_ORIGIN=https://seu-dominio.com.br,http://localhost:5173

# Retenção e expurgo automático de dados pessoais de alunos em dias (LGPD Art. 15/16).
# Define o tempo de guarda de respostas_alunos antes do expurgo automático (padrão: 365 dias).
# RETENTION_DAYS=365

# Retenção e expurgo de pontuações de minigames/ranking gamificado (padrão: 30 dias).
# RANKING_RETENTION_DAYS=30

# Desativação temporária de rate limit em testes de carga ou pipelines locais (apenas não-produção).
# DISABLE_RATE_LIMIT=false

# Diretório dos arquivos estáticos compilados do frontend (usado para servir os slides Marp e SPA).
# FRONTEND_STATIC_DIR=./frontend/dist

# Diretório onde residem os templates HTML de e-mail do sistema.
# TEMPLATES_DIR=./backend/src/templates

# ------------------------------------------------------------------------------
# 3. ENVIADOR DE E-MAILS (SMTP / NOTIFICAÇÕES PEDAGÓGICAS)
# ------------------------------------------------------------------------------
# Host ou IP do servidor de envio de e-mail SMTP (ex: smtp.zoho.com, smtp.gmail.com, mailhog).
SMTP_HOST=smtp.zoho.com

# Porta do servidor SMTP (465 para SSL/TLS implícito, 587 para STARTTLS, 1025 para Mailhog).
SMTP_PORT=465

# Usuário ou conta de login do servidor SMTP.
SMTP_USERNAME=usuario@exemplo.com

# Senha da conta SMTP ou Senha de Aplicativo gerada no seu provedor de e-mail.
SMTP_PASSWORD=senha_do_smtp_aqui

# Endereço de e-mail remetente que aparecerá no cabeçalho das mensagens enviadas.
MAIL_FROM=contato@exemplo.com

# ------------------------------------------------------------------------------
# 4. INTEGRACAO COM IA / LLM (AI_PROVIDER / AI_MODEL)
# ------------------------------------------------------------------------------
# ATENCAO: escolher AI_PROVIDER e OBRIGATORIO e MANUAL. Nao existe deteccao
# automatica de provider: o valor define o preset (base URL, chave e formato de
# payload). Valores aceitos: opencode (default) | 9router | openai | anthropic
#
#   opencode  -> https://opencode.ai/zen/go/v1    POST /chat/completions (shape OpenAI)
#   9router   -> http://127.0.0.1:20128/v1        POST /chat/completions (shape OpenAI)
#   openai    -> https://api.openai.com/v1        POST /chat/completions (shape OpenAI)
#   anthropic -> https://api.anthropic.com/v1     POST /messages (Messages API: usa
#                x-api-key + header anthropic-version e envia o system prompt no campo
#                top-level "system"; exige AI_MAX_TOKENS definido)
AI_PROVIDER=opencode

# Modelo padrao unico, usado por todos os presets (id exato aceito pela API alvo).
AI_MODEL=deepseek-v4.1-flash

# Modelo unico de reserva. Vazio = sem fallback (nao tenta um segundo modelo).
AI_FALLBACK_MODEL=

# Override explicito da URL base. Vazio = usa a base default do preset escolhido.
AI_BASE_URL=

# Override explicito da chave da API. Vazio = usa a chave default do preset.
AI_API_KEY=

# Timeout por chamada em milissegundos (default: 180000 = 3 minutos).
AI_TIMEOUT_MS=180000

# Maximo de tokens na resposta (default: 8192). Obrigatorio no provider anthropic.
AI_MAX_TOKENS=8192

# Header anthropic-version (default: 2023-06-01). So usado com AI_PROVIDER=anthropic.
AI_ANTHROPIC_VERSION=2023-06-01

# --- Retrocompatibilidade (variaveis legadas, sendo substituidas) ---
# As variaveis legadas abaixo sao lidas SOMENTE quando a variavel AI_* correspondente
# estiver VAZIA e SOMENTE dentro do preset ja escolhido por AI_PROVIDER. O provider
# nunca e inferido automaticamente a partir delas. Prefira sempre as variaveis AI_*.

# Preset opencode: OPENCODE_BASE_URL, OPENCODE_API_KEY, OPENCODE_MODEL, OPENCODE_UA
# (OPENCODE_UA envia um User-Agent customizado ao upstream).
OPENCODE_API_KEY=
OPENCODE_BASE_URL=https://opencode.ai/zen/go/v1
OPENCODE_MODEL=deepseek-v4.1-flash
# OPENCODE_UA=opencode/1.18.30

# Preset 9router: NINE_ROUTER_URL, NINE_ROUTER_API_KEY
# - No Docker Dev: use http://host.docker.internal:20128/v1
# - No Host direto / Produção com host network: use http://127.0.0.1:20128/v1
NINE_ROUTER_URL=http://127.0.0.1:20128/v1
NINE_ROUTER_API_KEY=sk_local_9r

# --- Exemplo: endpoint generico "OpenAI-compatible" ---
# AI_PROVIDER=openai
# AI_BASE_URL=https://meu-gateway.exemplo.com/v1
# AI_API_KEY=sk-minha-chave
# AI_MODEL=meu-modelo-openai

# --- Exemplo: endpoint generico "Anthropic-compatible" ---
# AI_PROVIDER=anthropic
# AI_BASE_URL=https://meu-proxy.exemplo.com/v1
# AI_API_KEY=sk-ant-minha-chave
# AI_MODEL=claude-sonnet-4-5
# AI_MAX_TOKENS=8192
# AI_ANTHROPIC_VERSION=2023-06-01

# AVISO: no provider opencode a OPENCODE_API_KEY (ou AI_API_KEY) e OBRIGATORIA.
# Sem ela as rotas de IA respondem 503 com "AI_API_KEY nao configurada" em vez de
# tentar autenticar com um valor placeholder invalido. Deixe VAZIA se nao for usar.
# ATENCAO: a URL https://api.opencode.ai/v1 NAO existe e devolve 200 com corpo
# "Not Found" (text/plain); o endpoint Go correto exige os headers de sessao, ja
# injetados pelo backend.

# ------------------------------------------------------------------------------
# 5. DEPLOY, DOMÍNIO & SERVIDOR WEB (NGINX / CERTBOT / PRODUÇÃO)
# ------------------------------------------------------------------------------
# Domínio público principal apontado para o servidor.
SERVER_NAME=seu-dominio.com.br

# Diretório no host onde são montados os certificados SSL/TLS emitidos pelo Certbot.
sslDir=/var/www/ssl

# Diretório no host para o desafio HTTP-01 ACME do Certbot (.well-known/acme-challenge).
verificationDir=/var/www/certbot


