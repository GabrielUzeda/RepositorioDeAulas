# ==============================================================================
# ARCHITECTURE & ENVIRONMENT CONFIGURATION (example.env)
# ==============================================================================
# Renomeie ou copie este arquivo para `.env` na raiz do projeto antes de iniciar.
# Exemplo: cp example.env .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CREDENCIAIS DE SEED E AUTENTICAÇÃO
# ------------------------------------------------------------------------------
# E-mail inicial do usuário Administrador criado automaticamente na 1ª execução do BD
PROFESSOR_EMAIL=admin@escola.com

# Senha inicial do usuário Administrador criado automaticamente na 1ª execução do BD.
# Obrigatório alterar em produção.
PROFESSOR_PASSWORD=MudeEstaSenha!

# Chave secreta usada para assinar e validar os tokens JWT no backend.
# ATENÇÃO: Altere para uma string longa e aleatória em ambiente de produção!
JWT_SECRET=change-me-to-a-random-secret-key-production-2026

# ------------------------------------------------------------------------------
# 2. CONFIGURAÇÕES DO SERVIDOR BACKEND (HONO / BUN)
# ------------------------------------------------------------------------------
# IP de escuta do servidor HTTP backend (padrão: 0.0.0.0)
# HOST=0.0.0.0

# Porta TCP do servidor backend (padrão: 8080)
# PORT=8080

# Diretório base para armazenamento de dados e arquivos persistentes
# DATA_DIR=./backend/data

# Caminho para o banco de dados SQLite principal (o código lê DATABASE_PATH, NÃO DB_PATH)
# DATABASE_PATH=./backend/data/app.db

# Origens CORS permitidas (lista separada por vírgula) — [3.4
# Ex.: CORS_ORIGIN=https://app.exemplo.com,http://localhost:5173
# Se NÃO definido, o backend usa apenas http://localhost (dev local). Defina explicitamente em produção.
# CORS_ORIGIN=https://app.exemplo.com,http://localhost:5173

# Retenção de dados pessoais (respostas_alunos/ranking) em dias — [4.4] LGPD Art. 15/16
# Padrão sugerido: 365 (1 ano letivo). Backend purga automaticamente dados mais antigos na inicialização e diariamente.
# RETENTION_DAYS=365

# Diretório dos arquivos estáticos do frontend Vue.js compilados (dist)
# FRONTEND_STATIC_DIR=./frontend/dist

# Diretório dos templates HTML de e-mail do sistema
# TEMPLATES_DIR=./backend/src/templates

# ------------------------------------------------------------------------------
# 3. ENVIADOR DE E-MAILS (SMTP / NOTIFICAÇÕES)
# ------------------------------------------------------------------------------
# Endereço ou Host do servidor SMTP (ex: smtp.zoho.com, maildev)
SMTP_HOST=smtp.zoho.com

# Porta do servidor SMTP (ex: 465 para SSL/TLS, 587 para STARTTLS, 1025 para MailDev)
SMTP_PORT=465

# Usuário/Conta de autenticação do servidor SMTP
SMTP_USERNAME=usuario@exemplo.com

# Senha da conta SMTP ou Senha de Aplicativo
SMTP_PASSWORD=senha_do_smtp_aqui

# Endereço remetente exibido nas mensagens enviadas aos alunos/professores
MAIL_FROM=contato@exemplo.com

# ------------------------------------------------------------------------------
# 4. DEPLOY, DOMÍNIO & SERVIDOR WEB (NGINX / PROD)
# ------------------------------------------------------------------------------
# Domínio principal do servidor onde a aplicação será publicada
SERVER_NAME=seu-dominio.com.br

# Diretório no host contendo os certificados SSL/TLS (Let's Encrypt / Certbot)
sslDir=/var/www/ssl

# Diretório para validação ACME/HTTP-01 do Certbot (.well-known/acme-challenge).
# DEVE ser o mesmo caminho usado no README (Opção A passo 3) e no compose.
verificationDir=/var/www/certbot

# Obs.: o build do frontend (dist/) é montado nos containers direto de ./frontend/dist
# (bun-server -> /app/frontend_static e nginx -> /usr/share/nginx/html).
# As variáveis legadas frontDir/backDir foram removidas — não são usadas pelos composes.
